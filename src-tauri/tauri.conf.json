{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipath",
  "version": "1.0.0",
  "identifier": "com.clipath.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipath",
        "width": 780,
        "height": 580,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "publisher": "Clipath",
    "copyright": "Copyright \u00a9 2026 Clipath",
    "shortDescription": "Capture. Annotate. Paste the path.",
    "longDescription": "Clipath is a screenshot tool for people who work in a terminal. Every capture is saved to a folder you choose, and its absolute path is one keystroke away \u2014 ready to paste into Claude Code, Codex CLI, or any prompt that takes a file.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Clipath",
        "installerIcon": "installer/installer.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    }
  }
}
